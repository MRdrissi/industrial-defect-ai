{
 "category": "bottle",
 "dataset": "ipythonx/mvtec-ad",
 "manifest": "docs/data/us-02-03/bottle_manifest.csv",
 "transform": {
  "profile": "patchcore",
  "size": [
   256,
   256
  ]
 },
 "environment": {
  "platform": "Kaggle",
  "python_version": "3.13.16",
  "torch": "2.11.0+cu130",
  "torchvision": "0.26.0+cu130",
  "anomalib": "2.7.0",
  "timm": "1.0.30",
  "lightning": "2.6.6",
  "gpu": "Tesla T4",
  "cuda_runtime": "13.0"
 },
 "model": {
  "backbone": "wide_resnet50_2",
  "pre_trained": true,
  "frozen": true,
  "layers": [
   "layer2",
   "layer3"
  ],
  "num_neighbors": 1
 },
 "memory_bank": {
  "split": "train",
  "sample_count": 8,
  "sampling": "torch.randperm",
  "seed": 42,
  "batch_size": 2,
  "num_workers": 0,
  "coreset": "KCenterGreedy",
  "sampling_ratio": 0.1
 },
 "inference": {
  "split": "val",
  "image_path": "bottle/train/good/002.png",
  "dtype": "float32",
  "tolerances": {
   "score_absolute": 0.001,
   "map_absolute": 0.001,
   "map_relative_to_range": 0.0001
  }
 }
}
