{
  "protocol_id": "industrial-defect-ai-epic05-v1",
  "protocol_version": "1.1.0",
  "dataset": {
    "name": "MVTec AD",
    "training_split": "train",
    "calibration_split": "val",
    "evaluation_split": "test",
    "validation_contains_only_normal_images": true,
    "test_used_for_calibration": false
  },
  "instances": {
    "model_families": [
      "cae",
      "patchcore"
    ],
    "categories": [
      "bottle",
      "hazelnut",
      "transistor"
    ],
    "expected_count": 6
  },
  "prediction_contract": {
    "normal_label": 0,
    "anomaly_label": 1,
    "higher_score_means_more_anomalous": true,
    "decision_rule": "score > threshold",
    "cae_image_score": "max_gaussian_smoothed_channel_mean_squared_reconstruction_error",
    "patchcore_image_score": "native_pred_score",
    "score_normalization_on_test": false,
    "score_definitions": {
      "cae": {
        "method": "max_gaussian_smoothed_channel_mean_squared_reconstruction_error",
        "smoothing_sigma": 4.0,
        "kernel_size": 33
      },
      "patchcore": {
        "method": "native_pred_score"
      }
    }
  },
  "spatial_evaluation": {
    "target_size_hw": [
      256,
      256
    ],
    "ground_truth_mask_values": [
      0,
      1
    ],
    "raw_mask_255_conversion": "explicit_binary_conversion_in_dataset_adapter",
    "mask_interpolation": "nearest",
    "anomaly_map_interpolation": "bilinear",
    "normal_missing_mask": "all_zero_mask",
    "anomalous_missing_mask": "error",
    "all_models_use_identical_resolution": true,
    "anomaly_map_backend": "torch.nn.functional.interpolate",
    "align_corners": false,
    "antialias": true,
    "evaluation_map_dtype": "float64",
    "positive_mask_disappearance": "error"
  },
  "metrics": {
    "image": [
      "image_auroc",
      "precision",
      "recall",
      "f1"
    ],
    "pixel": [
      "pixel_auroc"
    ],
    "image_auroc_input": "continuous_image_scores",
    "pixel_auroc_input": "pooled_pixels_over_all_images",
    "classification_level": "image",
    "undefined_auroc": null,
    "zero_division": 0,
    "macro_average": "unweighted_per_category",
    "report_undefined_metric_counts": true
  },
  "calibration": {
    "method": "normal_validation_quantile",
    "quantile": 0.95,
    "quantile_method": "linear",
    "calibrate_per_model_and_category": true,
    "number_of_thresholds": 6,
    "thresholds_frozen_before_test": true,
    "test_labels_used_for_calibration": false
  },
  "latency": {
    "unit": "ms",
    "scope": "model_inference_only",
    "batch_size": 1,
    "warmup_runs_per_model": 3,
    "synchronize_cuda": true,
    "exclude_disk_io": true,
    "exclude_preprocessing": true,
    "exclude_device_transfer": true,
    "statistics": [
      "mean",
      "median",
      "p95",
      "min",
      "max"
    ]
  },
  "exports": {
    "predictions": "predictions.csv",
    "metrics": "metrics.json",
    "manifest": "manifest.json",
    "pixel_artifacts": "artifacts/*.npz",
    "integrity": "sha256",
    "overwrite_existing_run": false
  },
  "required_provenance": [
    "run_id",
    "model_family",
    "category",
    "split",
    "git_commit",
    "checkpoint_sha256",
    "dataset_manifest_sha256",
    "device",
    "hardware",
    "python_version",
    "torch_version",
    "threshold",
    "latency_scope",
    "target_size_hw"
  ]
}
